# LLM provider: groq (default), openai or ollama. All use the OpenAI-compatible API.
LLM_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # e.g. Ollama from inside Docker

# Retrieval
# TOP_K=5            # chunks sent to the LLM
# CANDIDATES=30      # chunks per retriever before fusion / reranking
# USE_RERANK=false   # cross-encoder reranking (see README for why it is off by default)
